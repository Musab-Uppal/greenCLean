# ─────────────────────────────────────────────────────────────────────────────
# Green Clean Group — Environment Variables Example
# Duplicate this file as .env and fill in the values for your environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Database ──
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# ── Admin Panel ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password
ADMIN_SECRET=your_jwt_secret_key
# Optional Stealth Gate: If set, visiting /adminpage returns 404 unless accessed via /adminpage?key=YOUR_ACCESS_KEY
# ADMIN_ACCESS_KEY=your_secret_stealth_key

# ── Stripe (UK · GBP) ──
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── PayPal (GBP) ──
PAYPAL_MODE=sandbox # or 'live'
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# ── Mailchimp (Email Marketing & Automation) ──
# 1. Sign up / log in to Mailchimp (https://mailchimp.com)
# 2. Go to: Account & billing -> Extras -> API keys -> Create A Key
MAILCHIMP_API_KEY=your_mailchimp_api_key_here

# 3. In Mailchimp, go to: Audience -> Audience dashboard -> Manage Audience -> Settings
#    Find Audience ID (List ID) under "Audience name and defaults"
MAILCHIMP_LIST_ID=your_mailchimp_audience_list_id_here

# 4. Your server prefix is at the end of your API key (e.g. key ends with -us21 -> prefix is us21)
#    Or in your Mailchimp URL (e.g. https://us21.admin.mailchimp.com)
MAILCHIMP_SERVER_PREFIX=us21

# ── Email Addresses & Sender Configuration ─────────────────────────────────────
# Outgoing sender address for transactional emails to clients (e.g. confirmations, newsletters)
FROM_EMAIL=noreply@greencleangroup.co.uk

# Reply-To address so customer replies route directly to the team inbox
REPLY_TO_EMAIL=info@greencleangroup.co.uk

# Admin email for booking notifications and contact enquiries
ADMIN_NOTIFICATION_EMAIL=info@greencleangroup.co.uk
ADMIN_EMAIL=info@greencleangroup.co.uk

# ── Transactional Email Delivery (Booking Confirmations & Admin Alerts) ──
# Option 1: Direct SMTP (Recommended: e.g. domain cPanel, Titan, Gmail, Brevo, SendGrid)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@greencleangroup.co.uk
SMTP_PASS=your_email_password
SMTP_FROM="Green Clean Group <noreply@greencleangroup.co.uk>"

# Option 2: Mailchimp Transactional (Mandrill) API key
MANDRILL_API_KEY=your_mandrill_api_key_here

# Option 3: Resend API Key
RESEND_API_KEY=re_your_resend_api_key_here
