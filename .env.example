# ─────────────────────────────────────────────────────────────────────────────
# Green Clean Group — Environment Variables Example
# Duplicate this file as .env and fill in the values for your environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Database ──
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# ── Admin Panel ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password
ADMIN_SECRET=your_jwt_secret_key

# ── Stripe (UK · GBP) ──
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── PayPal (GBP) ──
PAYPAL_MODE=sandbox # or 'live'
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# ── Mailchimp (Email Marketing & Automation) ──
# 1. Sign up / log in to Mailchimp (https://mailchimp.com)
# 2. Go to: Account & billing -> Extras -> API keys -> Create A Key
MAILCHIMP_API_KEY=your_mailchimp_api_key_here

# 3. In Mailchimp, go to: Audience -> Audience dashboard -> Manage Audience -> Settings
#    Find Audience ID (List ID) under "Audience name and defaults"
MAILCHIMP_LIST_ID=your_mailchimp_audience_list_id_here

# 4. Your server prefix is at the end of your API key (e.g. key ends with -us21 -> prefix is us21)
#    Or in your Mailchimp URL (e.g. https://us21.admin.mailchimp.com)
MAILCHIMP_SERVER_PREFIX=us21
