// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  slug            String?          @unique
  image           String?
  productServices ProductService[]

  @@map("category")
}

model ProductService {
  id          Int         @id @default(autoincrement())
  name        String
  categoryId  Int         @map("category_id")
  price       Float
  width       String?
  time        String
  slug        String?     @unique
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orders      Order[]
  orderItems  OrderItem[]

  @@map("product_service")
}

model Order {
  id               Int             @id @default(autoincrement())
  productServiceId Int?            @map("product_service_id")
  customerEmail    String          @map("customer_email")
  customerPhone    String?         @map("customer_phone")
  phoneno          String
  address          String
  status           String          @default("pending")
  scheduledDate    String?         @map("scheduled_date")
  paymentMethod    String?         @default("local") @map("payment_method")
  paymentStatus    String?         @default("pending") @map("payment_status")
  stripeSessionId  String?         @map("stripe_session_id")
  totalAmount      Float           @default(0) @map("total_amount")
  createdAt        DateTime        @default(now()) @map("created_at")
  // Marketing consent fields (GDPR)
  marketingConsent Boolean         @default(false) @map("marketing_consent")
  consentDate      DateTime?       @map("consent_date")
  consentWording   String?         @map("consent_wording")
  consentSource    String?         @default("booking-form") @map("consent_source")
  couponCode       String?         @map("coupon_code")
  discountAmount   Float?          @default(0) @map("discount_amount")
  productService   ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)
  orderItems       OrderItem[]

  @@map("orders")
}

model OrderItem {
  id               Int            @id @default(autoincrement())
  orderId          Int            @map("order_id")
  productServiceId Int            @map("product_service_id")
  price            Float
  createdAt        DateTime       @default(now()) @map("created_at")
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productService   ProductService @relation(fields: [productServiceId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model NewsletterSubscriber {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  phone           String?
  source          String?   @default("website")
  createdAt       DateTime  @default(now()) @map("created_at")
  // Marketing consent fields (GDPR)
  marketingConsent Boolean  @default(false) @map("marketing_consent")
  consentDate      DateTime? @map("consent_date")
  consentWording   String?  @map("consent_wording")
  consentSource    String?  @default("newsletter-form") @map("consent_source")

  @@map("newsletter_subscribers")
}

model Coupon {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  discountType   String    @default("percentage") @map("discount_type") // 'percentage' | 'fixed'
  discountValue  Float     @map("discount_value")
  minOrderAmount Float?    @default(0) @map("min_order_amount")
  maxUses        Int?      @map("max_uses")
  usedCount      Int       @default(0) @map("used_count")
  expiresAt      DateTime? @map("expires_at")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("coupons")
}

model BlockedDate {
  id        Int      @id @default(autoincrement())
  date      String   @unique
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blocked_dates")
}
