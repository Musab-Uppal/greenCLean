!.yarn/plugins
!.yarn/releases
!.yarn/versions

# environment files and secrets
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
*.cer
*.der
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
